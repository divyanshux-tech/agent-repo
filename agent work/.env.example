# ============================================================
# Plan Through Us — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ----- Supabase / PostgreSQL -----
# Get these from: Supabase Dashboard → Settings → Database → Connection string

# Transaction pooler URL (port 6543) — used by the app at runtime
# Tab: "Transaction" in Supabase connection strings
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (port 5432) — used by Prisma for migrations ONLY
# Tab: "URI" in Supabase connection strings
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
REDIS_URL="redis://localhost:6379"

# ----- LLM / AI Provider (Google Gemini) -----
GEMINI_API_KEY="AIza..."
GOOGLE_AI_API_KEY=""
OPENAI_API_KEY=""

# ----- SerpAPI (Google Flights & Hotels for Phase 4) -----
SERPAPI_KEY=""

# ----- Travel Provider API (Phase 4) -----
TRAVEL_API_KEY=""
TRAVEL_API_BASE_URL=""

# ----- Hotel Provider API (Phase 4) -----
HOTEL_API_KEY=""
HOTEL_API_BASE_URL=""

# ----- Payment Gateway (Phase 8) -----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ----- App -----
NODE_ENV="development"
PORT=3000
APP_SECRET="change_me_to_a_random_secret"
