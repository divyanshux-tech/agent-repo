// ============================================================
// Plan Through Us — Prisma Schema
// Phase 1: Foundations & Data Layer
//
// Golden rule: This schema owns ALL durable state.
// T1/T2/H1/H2 candidate IDs are session-scoped aliases stored
// in trip_candidates — they are NOT ML training data.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Pooled connection — used by app at runtime
  directUrl = env("DIRECT_URL")         // Direct connection — used by Prisma for migrations
}

// ============================================================
// ENUM TYPES
// ============================================================

enum TripStatus {
  planning // Collecting requirements / selecting destination
  searching // Parallel agents fetching candidates
  review // Plans generated, awaiting user selection
  selected_for_booking // User selected a plan, pre-booking
  booking_in_progress // Payment / revalidation ongoing
  booked // All components confirmed & paid
  cancelled // Trip cancelled
  expired // Session timed out without booking
}

enum CandidateType {
  TRAVEL
  HOTEL
  ACTIVITY
}

enum BookingStatus {
  pending
  confirmed
  failed
  cancelled
  refunded
}

enum SpendingStyle {
  budget
  standard
  luxury
}

// ============================================================
// USERS
// Durable user identity. Preferences stored as JSON for
// flexibility without schema churn.
// ============================================================
model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  phone       String?  @unique
  name        String?
  homeCity    String?  @map("home_city")
  preferences Json? // { language_pref, interests, default_spending_style, ... }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trips                 Trip[]
  tripSearches          TripSearch[]
  userInteractions      UserInteraction[]
  recommendationResults RecommendationResult[]

  @@map("users")
}

// ============================================================
// TRIPS
// Core trip record. status drives the state machine.
// total_budget is the ONE shared wallet — never split here.
// ============================================================
model Trip {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  source      String // e.g. "Delhi", "DEL"
  destination String? // Null until destination agent locks it
  travelDate  DateTime?  @map("travel_date")
  returnDate  DateTime?  @map("return_date")
  days        Int
  travellers  Int
  totalBudget Decimal    @map("total_budget") @db.Decimal(12, 2)
  currency    String     @default("INR")
  status      TripStatus @default(planning)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  expiresAt   DateTime?  @map("expires_at") // Set when session goes stale

  user          User               @relation(fields: [userId], references: [id])
  requirements  TripRequirement?
  candidates    TripCandidate[]
  costEstimates TripCostEstimate[]
  plans         TripPlan[]
  selectedPlan  SelectedPlan?
  bookings      Booking[]
  apiSearchLogs ApiSearchLog[]

  @@index([userId])
  @@index([status])
  @@map("trips")
}

// ============================================================
// TRIP REQUIREMENTS
// Structured slot-filled requirements extracted by the
// Orchestrator Agent from Hinglish / English conversation.
// One-to-one with Trip.
// ============================================================
model TripRequirement {
  id            String        @id @default(uuid())
  tripId        String        @unique @map("trip_id")
  interests     String[] // e.g. ["beaches", "food", "nightlife"]
  constraints   Json? // { non_stop_only: true, max_hotel_stars: 5, ... }
  spendingStyle SpendingStyle @default(standard) @map("spending_style")
  extraFields   Json?         @map("extra_fields") // Conversation-derived overflow
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_requirements")
}

// ============================================================
// TRIP CANDIDATES
// Curated options returned by Travel / Hotel / Activity Agents.
// "T1", "T2", "H1", "H2", "A1" etc. are shorthand aliases
// stored in the `alias` field — scoped to ONE trip session.
// Provider's full payload stored in metadataJson for traceability.
// expires_at reflects the provider's price validity window.
// ============================================================
model TripCandidate {
  id                String        @id @default(uuid())
  tripId            String        @map("trip_id")
  type              CandidateType // TRAVEL | HOTEL | ACTIVITY
  alias             String? // "T1", "H2", "A3" — session-scoped label only
  provider          String // e.g. "ExampleAir", "ExampleHotelAPI"
  providerReference String        @map("provider_reference") // Raw result key for auditability
  price             Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  startTime         DateTime?     @map("start_time")
  endTime           DateTime?     @map("end_time")
  metadataJson      Json          @map("metadata_json") // Full provider payload
  expiresAt         DateTime?     @map("expires_at") // Price validity window
  superseded        Boolean       @default(false) // True when replaced by replan
  createdAt         DateTime      @default(now()) @map("created_at")

  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelPlans   TripPlan[]         @relation("TravelCandidate")
  hotelPlans    TripPlan[]         @relation("HotelCandidate")
  activityPlans TripPlanActivity[]

  @@index([tripId, type])
  @@index([expiresAt])
  @@map("trip_candidates")
}

// ============================================================
// TRIP COST ESTIMATES
// Non-booked expense estimates (food, local transport, misc).
// These are ESTIMATES — clearly labeled as such in the UI.
// Multiple estimates can exist per trip (e.g. after replan with
// different spending_style).
// ============================================================
model TripCostEstimate {
  id                     String        @id @default(uuid())
  tripId                 String        @map("trip_id")
  foodEstimate           Decimal       @map("food_estimate") @db.Decimal(12, 2)
  localTransportEstimate Decimal       @map("local_transport_estimate") @db.Decimal(12, 2)
  otherEstimate          Decimal       @default(0) @map("other_estimate") @db.Decimal(12, 2)
  estimationMethod       String        @map("estimation_method") // e.g. "destination_profile"
  profileLevel           SpendingStyle @map("profile_level")
  confidence             String? // e.g. "HIGH", "MEDIUM", "LOW"
  currency               String        @default("INR")
  source                 String? // Reference to cost profile version used
  createdAt              DateTime      @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_cost_estimates")
}

// ============================================================
// TRIP PLANS
// Generated plan combinations from the Budget Optimizer.
// Each plan is one feasible combination of Travel + Hotel + 
// Activities. Nothing is booked at this stage.
// estimatedTotal = travel + hotel + activities + nonBookedCost
// ============================================================
model TripPlan {
  id                String   @id @default(uuid())
  tripId            String   @map("trip_id")
  travelCandidateId String   @map("travel_candidate_id")
  hotelCandidateId  String   @map("hotel_candidate_id")
  estimatedTotal    Decimal  @map("estimated_total") @db.Decimal(12, 2)
  currency          String   @default("INR")
  label             String // "Best Value", "Better Hotel", "Better Travel"
  score             Float? // Optimizer ranking score
  nonBookedCostUsed Decimal  @map("non_booked_cost_used") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelCandidate TripCandidate      @relation("TravelCandidate", fields: [travelCandidateId], references: [id])
  hotelCandidate  TripCandidate      @relation("HotelCandidate", fields: [hotelCandidateId], references: [id])
  activities      TripPlanActivity[]
  selectedPlan    SelectedPlan?

  @@index([tripId])
  @@map("trip_plans")
}

// ============================================================
// TRIP PLAN ACTIVITIES
// Join table: which activity candidates are included in a plan.
// Activities are optional — a plan can have zero.
// ============================================================
model TripPlanActivity {
  planId      String @map("plan_id")
  candidateId String @map("candidate_id")

  plan      TripPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  candidate TripCandidate @relation(fields: [candidateId], references: [id])

  @@id([planId, candidateId])
  @@map("trip_plan_activities")
}

// ============================================================
// SELECTED PLANS
// Written when user explicitly chooses one plan.
// Immutable after creation — triggers booking flow.
// ============================================================
model SelectedPlan {
  id         String   @id @default(uuid())
  tripId     String   @unique @map("trip_id")
  planId     String   @unique @map("plan_id")
  selectedAt DateTime @default(now()) @map("selected_at")

  trip Trip     @relation(fields: [tripId], references: [id])
  plan TripPlan @relation(fields: [planId], references: [id])

  @@map("selected_plans")
}

// ============================================================
// BOOKINGS
// Created by the Booking Service ONLY after plan selection.
// One booking record per component (travel, hotel, each activity).
// Stores final confirmed price and provider confirmation reference.
// ============================================================
model Booking {
  id                    String        @id @default(uuid())
  tripId                String        @map("trip_id")
  componentType         CandidateType @map("component_type")
  provider              String
  providerReference     String        @map("provider_reference") // Provider's booking/order ID
  candidateId           String?       @map("candidate_id") // Link back to original candidate
  finalPrice            Decimal       @map("final_price") @db.Decimal(12, 2)
  currency              String        @default("INR")
  status                BookingStatus @default(pending)
  confirmationReference String?       @map("confirmation_reference") // PNR, voucher code, etc.
  bookedAt              DateTime?     @map("booked_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@map("bookings")
}

// ============================================================
// API SEARCH LOGS
// Audit trail for every provider API call made during planning.
// responseReference points to raw payload stored in Redis or
// object storage (not stored inline to avoid DB bloat).
// ============================================================
model ApiSearchLog {
  id                String   @id @default(uuid())
  tripId            String   @map("trip_id")
  provider          String
  agentType         String   @map("agent_type") // "travel", "hotel", "activity"
  requestMetadata   Json     @map("request_metadata") // sanitized request params
  responseReference String?  @map("response_reference") // Redis key / S3 key
  responseStatus    String   @map("response_status") // "success", "error", "timeout"
  latencyMs         Int?     @map("latency_ms")
  timestamp         DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([timestamp])
  @@map("api_search_logs")
}

// ============================================================
// DESTINATION COST PROFILES
// Admin-maintained table of per-destination cost baselines
// used by the Trip Expense Estimator (Phase 5).
// Separate rows per profile_level (budget / standard / luxury).
// ============================================================
model DestinationCostProfile {
  id                  String        @id @default(uuid())
  destination         String // e.g. "Goa", "Manali", "Andaman"
  profileLevel        SpendingStyle @map("profile_level")
  foodDailyPerPerson  Decimal       @map("food_daily_per_person") @db.Decimal(10, 2)
  transportDailyTotal Decimal       @map("transport_daily_total") @db.Decimal(10, 2)
  notes               String? // e.g. "includes auto + one local excursion"
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@unique([destination, profileLevel])
  @@index([destination])
  @@map("destination_cost_profiles")
}

// ============================================================
// DESTINATIONS
// Rich destination metadata for the Phase 3 Recommendation
// Engine. Each destination has feature scores (0.0–1.0) for
// content-based matching, group-fit scores, cost tiers, and
// seasonality data. Replaces the old hardcoded JS catalog.
// ============================================================
model Destination {
  id                String   @id @default(uuid())
  name              String   // e.g. "Goa", "Manali", "Ladakh"
  city              String   // e.g. "Panaji", "Leh"
  state             String   // e.g. "Goa", "Himachal Pradesh"
  country           String   @default("India")
  region            String   // e.g. "West", "North", "South"
  latitude          Float?
  longitude         Float?

  // Cost & logistics
  averageTripCost   Decimal  @map("average_trip_cost") @db.Decimal(12, 2)
  nearestAirport    String?  @map("nearest_airport")
  idealDaysMin      Int      @default(3) @map("ideal_days_min")
  idealDaysMax      Int      @default(7) @map("ideal_days_max")

  // Feature scores (0.0 – 1.0) for content-based matching
  mountainScore     Float    @default(0) @map("mountain_score")
  beachScore        Float    @default(0) @map("beach_score")
  climbingScore     Float    @default(0) @map("climbing_score")
  trekkingScore     Float    @default(0) @map("trekking_score")
  adventureScore    Float    @default(0) @map("adventure_score")
  nightlifeScore    Float    @default(0) @map("nightlife_score")
  natureScore       Float    @default(0) @map("nature_score")
  cultureScore      Float    @default(0) @map("culture_score")
  foodScore         Float    @default(0) @map("food_score")
  relaxationScore   Float    @default(0) @map("relaxation_score")
  spiritualScore    Float    @default(0) @map("spiritual_score")

  // Group-fit scores (0.0 – 1.0)
  familyScore       Float    @default(0.5) @map("family_score")
  coupleScore       Float    @default(0.5) @map("couple_score")
  groupScore        Float    @default(0.5) @map("group_score")
  soloScore         Float    @default(0.5) @map("solo_score")

  // Quality & meta scores
  safetyScore       Float    @default(0.7) @map("safety_score")
  popularityScore   Float    @default(0.5) @map("popularity_score")

  // Seasonality
  bestSeason        String[] @map("best_season")  // ["Oct","Nov","Dec"]
  bestMonths        Int[]    @map("best_months")   // [10,11,12,1,2,3]

  // Budget tiers — daily cost per person
  budgetDailyCost   Decimal  @map("budget_daily_cost") @db.Decimal(10, 2)
  standardDailyCost Decimal  @map("standard_daily_cost") @db.Decimal(10, 2)
  luxuryDailyCost   Decimal  @map("luxury_daily_cost") @db.Decimal(10, 2)
  baseTransportCost Decimal  @map("base_transport_cost") @db.Decimal(10, 2)

  description       String?
  tags              String[]  // free-form tags for fallback matching
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  userInteractions      UserInteraction[]
  recommendationResults RecommendationResult[]

  @@unique([name, country])
  @@index([country])
  @@index([isActive])
  @@map("destinations")
}

// ============================================================
// TRIP SEARCHES
// Logs every search query the user makes. Used for analytics
// and as a feature source for ML model training.
// ============================================================
model TripSearch {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  origin      String
  travellers  Int
  budget      Decimal  @db.Decimal(12, 2)
  duration    Int      // days
  travelDates String?  @map("travel_dates")
  interests   String[]
  activities  String[]
  travelStyle String?  @map("travel_style") // "budget" | "standard" | "luxury"
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("trip_searches")
}

// ============================================================
// USER INTERACTIONS
// Tracks every user engagement with a destination:
// click, save, booking, rejection, rating.
// This data feeds the ML training pipeline.
// ============================================================
model UserInteraction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  destinationId String   @map("destination_id")
  clicked       Boolean  @default(false)
  saved         Boolean  @default(false)
  booked        Boolean  @default(false)
  rejected      Boolean  @default(false)
  rating        Float?   // 1.0 – 5.0
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([userId])
  @@index([destinationId])
  @@index([userId, destinationId])
  @@map("user_interactions")
}

// ============================================================
// RECOMMENDATION RESULTS
// Stores the output of every recommendation run.
// model_version tracks which scoring algorithm produced the result
// ("content_v1" for content-based, "lgbm_v1" for ML model, etc.)
// ============================================================
model RecommendationResult {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  destinationId String   @map("destination_id")
  score         Float
  rank          Int
  modelVersion  String   @default("content_v1") @map("model_version")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([userId])
  @@index([destinationId])
  @@map("recommendation_results")
}
